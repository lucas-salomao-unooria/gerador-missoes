# ==============================================================================
# Gerador de Missões — Google ADK Orchestrator
# .gitignore — Padrão Ouro (Python, Streamlit, MCP, Node, macOS/Linux/Windows)
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔑 Variáveis de Ambiente & Chaves de API (Segurança Crítica)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# ------------------------------------------------------------------------------
# 🐍 Ambientes Virtuais Python
# ------------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
.conda/
.python-version

# ------------------------------------------------------------------------------
# ⚡ Bytecode Python & Caches de Execução
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 📊 Streamlit Caches & Configurações Locais
# ------------------------------------------------------------------------------
.streamlit/secrets.toml
.streamlit/credentials.toml
!/.streamlit/config.toml

# ------------------------------------------------------------------------------
# 📦 Node.js / NPX (MCP Servers locais e dependências)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ------------------------------------------------------------------------------
# 🧪 Testes, Cobertura e Linters
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------------------------
# 💻 IDEs, Editores & Ferramentas
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
*.code-workspace

# JetBrains (PyCharm, IntelliJ, etc.)
.idea/
*.iml
*.iws

# Editores de Texto
*.swp
*.swo
*~
*.bak

# ------------------------------------------------------------------------------
# 🍎 Sistema Operacional (macOS, Windows, Linux)
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini

# Linux
*~

# ------------------------------------------------------------------------------
# 📝 Logs, Arquivos Temporários & Sessões de Execução
# ------------------------------------------------------------------------------
*.log
logs/
temp/
tmp/
*.tmp
*.bak
# ------------------------------------------------------------------------------
# Artefatos gerados pelo pipeline e tokens OAuth do Figma MCP
# ------------------------------------------------------------------------------
output/*
!output/.gitkeep
.figma_mcp_tokens.json
