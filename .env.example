# ============================================================================
# Gerador de Missões Unooria — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env.
# ============================================================================

# --- Google Gemini (https://aistudio.google.com/app/apikey) ------------------
GOOGLE_API_KEY="SUA_CHAVE_GEMINI_AQUI"
GEMINI_MODEL="gemini-3.8-flash"
# Modelo do redator do PRD (opcional; padrão = GEMINI_MODEL)
# GEMINI_MODEL_PRD="gemini-3.7-pro"

# Raciocínio: 0 = off | -1 = dinâmico | >0 = tokens (1024, 2048, 4096, 8192…)
THINKING_BUDGET=2048
INCLUDE_THOUGHTS=true

# --- Pipeline ----------------------------------------------------------------
# Etapas ativas (produto, design, dev). O agente transversal de aprendizado roda sempre.
PIPELINE_STAGES="produto,design,dev"
# true: missão bloqueada nos gates de produto interrompe design/dev (processo oficial).
# false: segue e o PRD registra as pendências.
PRODUTO_MODO_ESTRITO=true
# Gate determinístico BNCC Computação depois da spec: código inexistente, de outro ano ou sem letramento digital trava a esteira.
BNCC_CHECK_ESTRITO="true"
# Gates de Design e Dev: QA de design 🔴, banca 🔴, manifesto/telemetria/lacunas fora do contrato impedem o PRD.
# Lacuna cuja dona é a plataforma (ADR nova, componente de DS) não impede: o PRD sai 🟡.
ESTEIRA_ESTRITA="true"
# Rodadas do loop gate estrutural ↔ revisor do one-pager
GATE_ESTRUTURAL_MAX_RODADAS=3
# Pasta onde cada execução grava os artefatos (PRD.md, spec, relatórios, estado.json)
OUTPUT_DIR="output"

# --- MCP (comum a todos os servidores) ---------------------------------------
MCP_TIMEOUT_SECONDS=60
MCP_READ_TIMEOUT_SECONDS=600

# ---------------------------------------------------------------- Google Stitch
# auto (padrão) = remote se houver chave, senão off.
#   remote → endpoint MCP oficial https://stitch.googleapis.com/mcp (X-Goog-Api-Key)
#   proxy  → npx @_davideast/stitch-mcp, que CONSERTA os schemas que o backend
#            devolve quebrados. Use se o modo remote falhar ao listar ferramentas.
#            Atenção: o proxy lê o .env da pasta onde roda e pode quebrar com ele.
STITCH_MCP_MODE="auto"
STITCH_API_KEY=""
# Alternativa à chave: bearer OAuth + projeto de cota (config.py os lê, se houver).
STITCH_ACCESS_TOKEN=""
STITCH_QUOTA_PROJECT_ID=""
STITCH_MCP_REMOTE_URL="https://stitch.googleapis.com/mcp"
STITCH_MCP_COMMAND="npx"
STITCH_MCP_ARGS="-y,@_davideast/stitch-mcp,proxy"
STITCH_PROJECT_URL_BASE="https://stitch.withgoogle.com/projects"

# ------------------------------------------------------------------------ Miro
# Espelha no Miro os diagramas de jornada (D2) e fluxo de telas (D3). O Mermaid
# continua sendo a fonte — o board é publicado depois e devolve um link. Miro
# indisponível não derruba a esteira: a folha sai com "MIRO: indisponível".
# auto (padrão) = remote se houver conexão salva, senão off.
MIRO_MODE="auto"
MIRO_MCP_URL="https://mcp.miro.com/"
# O MCP do Miro é o próprio authorization server: o Streamlit registra o client
# dinamicamente (POST /register) e conduz o OAuth com PKCE. Não há nada a
# configurar no dev portal do Miro — só a URL de retorno abaixo, que precisa
# bater com o endereço em que o Streamlit atende.
MIRO_REDIRECT_URI="http://localhost:8501"
# Onde ficam access token, refresh token e o client emitido no registro.
# No Cloud Run o disco é efêmero: a conexão se perde a cada deploy.
MIRO_OAUTH_TOKENS_FILE=".miro_mcp_tokens.json"
# Time onde os boards nascem (opcional; vazio = o time escolhido ao conectar).
MIRO_TEAM_ID=""
# Teto de itens por board, para não bater no rate limit do Miro.
MIRO_MAX_ITENS=80
# Credenciais do app do dev portal. O MCP NÃO as usa; elas autenticam a REST
# API v2, que é o caminho alternativo se a escrita via MCP não servir.
MIRO_CLIENT_ID=""
MIRO_CLIENT_SECRET=""

# Google Drive — pasta onde o D0 (fechamento de lacunas) gravaria o relatório como Google Docs.
# Sem toolset do Drive configurado o agente registra "GDOCS: indisponível" e entrega só o Markdown.
GDRIVE_FOLDER_URL=""
