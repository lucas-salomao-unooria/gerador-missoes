# ============================================================================
# Gerador de Missões Unooria — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env.
# ============================================================================

# --- Google Gemini (https://aistudio.google.com/app/apikey) ------------------
GOOGLE_API_KEY="SUA_CHAVE_GEMINI_AQUI"
GEMINI_MODEL="gemini-3.7-flash"
# Modelo do redator do PRD (opcional; padrão = GEMINI_MODEL)
# GEMINI_MODEL_PRD="gemini-3.7-pro"

# Raciocínio: 0 = off | -1 = dinâmico | >0 = tokens (1024, 2048, 4096, 8192…)
THINKING_BUDGET=2048
INCLUDE_THOUGHTS=true

# --- Pipeline ----------------------------------------------------------------
# Etapas ativas (produto, design, dev). O agente transversal de aprendizado roda sempre.
PIPELINE_STAGES="produto,design,dev"
# true: missão bloqueada nos gates de produto interrompe design/dev (processo oficial).
# false: segue e o PRD registra as pendências.
PRODUTO_MODO_ESTRITO=true
# Rodadas do loop gate estrutural ↔ revisor do one-pager
GATE_ESTRUTURAL_MAX_RODADAS=3
# Pasta onde cada execução grava os artefatos (PRD.md, spec, relatórios, estado.json)
OUTPUT_DIR="output"

# --- Figma MCP ---------------------------------------------------------------
# off     → sem Figma; design entrega jornada/fluxo/wireframes em Markdown + Mermaid
# remote  → servidor oficial https://mcp.figma.com/mcp (OAuth). Único modo com ESCRITA
#           (use_figma, create_new_file, generate_diagram) e FigJam.
#           Rode uma vez: `python scripts/figma_oauth.py`  (gera .figma_mcp_tokens.json)
# desktop → servidor local do app Figma Desktop (Dev Mode MCP), sem auth
# stdio   → figma-developer-mcp via npx (comunidade, SÓ LEITURA, usa FIGMA_API_KEY)
FIGMA_MCP_MODE="off"
FIGMA_MCP_REMOTE_URL="https://mcp.figma.com/mcp"
FIGMA_MCP_DESKTOP_URL="http://127.0.0.1:3845/mcp"
FIGMA_MCP_OAUTH_TOKENS_FILE=".figma_mcp_tokens.json"
# Alternativa ao OAuth: bearer estático (se você já tiver um access token válido)
# FIGMA_MCP_BEARER_TOKEN=""
# Só para o modo stdio (Personal Access Token: https://www.figma.com/developers/api#access-tokens)
# FIGMA_API_KEY="figd_..."
FIGMA_MCP_COMMAND="npx"
FIGMA_MCP_ARGS="-y,figma-developer-mcp,--stdio"
MCP_TIMEOUT_SECONDS=60
MCP_READ_TIMEOUT_SECONDS=600

# Contexto Figma da Unooria
# Pasta/projeto onde os arquivos FigJam/Figma das missões são criados
FIGMA_DEFAULT_FOLDER_URL=""
# Design System Unooria (tokens e componentes) e Unooria_DS_v0.2
FIGMA_DS_FILE_KEY="mPw4Hhx9ptkgcHtySaSilO"
FIGMA_DS_V02_FILE_KEY="i0HRQSBtQQ9ZXDYiJPRnGv"
