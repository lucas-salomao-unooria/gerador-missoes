# Google Gemini API Key (Obtenha em https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY="SUA_CHAVE_GEMINI_AQUI"

# Modelo padrão do Google Gemini para os Agentes do ADK
GEMINI_MODEL="gemini-3.7-flash"

# Controle de Pensamento / Raciocínio (Thinking Config - Gemini 3.7 Flash)
# 0 = Desativado | -1 = Dinâmico automático | >0 = Orçamento em tokens (ex: 1024, 2048, 4096, 8192)
THINKING_BUDGET=2048
# Incluir fluxo de pensamento (Chain of Thought) nos eventos e inspeção da UI
INCLUDE_THOUGHTS=true

# Configuração do MCP do Figma
# Token pessoal do Figma (Figma Personal Access Token)
FIGMA_API_KEY="figd_rMIFyOVjCI6oc_EzTG1EYZE7GDEu0LeR_RGL4J6l"
FIGMA_PERSONAL_ACCESS_TOKEN="figd_rMIFyOVjCI6oc_EzTG1EYZE7GDEu0LeR_RGL4J6l"

# Comando e pacote do servidor MCP do Figma (padrão: npx -y figma-developer-mcp --stdio)
FIGMA_MCP_COMMAND="npx"
FIGMA_MCP_PACKAGE="figma-developer-mcp"
FIGMA_MCP_ARGS="-y,figma-developer-mcp,--stdio"

# Pasta de Destino Padrão no Figma / FigJam para Geração de Artefatos
FIGMA_DEFAULT_FOLDER_URL="https://www.figma.com/files/team/1669801444374741311/folder/648533591?fuid=1669362530798509991"
FIGMA_FOLDER_ID="648533591"
FIGMA_TEAM_ID="1669801444374741311"

# Habilitar modo Mock se o servidor MCP do Figma não estiver disponível localmente
ENABLE_FIGMA_MCP_MOCK_FALLBACK="true"
